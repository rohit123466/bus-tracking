# Copy to .env for `docker compose up`. Never commit .env.

# Random string, 32+ characters. e.g.  openssl rand -base64 48
JWT_SECRET=
# Admin dashboard / conductor console password, 12+ characters.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# Delhi Open Transit Data key (https://otd.delhi.gov.in). Without it no live buses are shown.
DTC_API_KEY=
POSTGRES_PASSWORD=dtc_pass
